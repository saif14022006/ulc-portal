{
  "name": "ulc-portal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ULC Toolkit — University Law College Quetta student toolkit PWA",
  "scripts": {
    "logo": "node scripts/process-logo.mjs",
    "start": "npx --yes serve -p 8080",
    "cap:copy": "node scripts/cap-copy.mjs",
    "cap:sync": "npm run cap:copy && npx cap sync android",
    "cap:open": "npx cap open android",
    "cap:icons": "node scripts/cap-android-assets.mjs",
    "android:debug": "npm run cap:sync && cd android && .\\gradlew.bat assembleDebug",
    "load-test": "node scripts/load-stress.mjs",
    "load-test:full": "node scripts/load-stress.mjs --students 1000 --teachers 1000 --awards 200 --covers 100 --concurrency 3 --delay 1500 --force-concurrency",
    "load-test:multi": "node scripts/load-multitask.mjs",
    "load-test:reset": "node -e \"import('fs').then(fs=>fs.promises.rm('scripts/.load-progress.json',{force:true}).then(()=>console.log('progress cleared')))\"",
    "test:sync": "node scripts/sync-accuracy.mjs",
    "test:probe": "node scripts/probe-supabase.mjs"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.4.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@supabase/supabase-js": "^2.110.8"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/cli": "^8.4.2",
    "sharp": "^0.34.5"
  }
}

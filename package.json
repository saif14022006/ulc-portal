{
  "name": "ulc-portal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ULC Portal — University Law College Quetta student toolkit PWA",
  "scripts": {
    "logo": "node scripts/process-logo.mjs",
    "start": "npx --yes serve -p 8080",
    "load-test": "node scripts/load-stress.mjs",
    "load-test:full": "node scripts/load-stress.mjs --students 1000 --teachers 1000 --awards 200 --covers 100",
    "load-test:reset": "node -e \"import('fs').then(fs=>fs.promises.rm('scripts/.load-progress.json',{force:true}).then(()=>console.log('progress cleared')))\""
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.8"
  },
  "devDependencies": {
    "sharp": "^0.34.5"
  }
}
